# Lab 01 - Man-in-the-Middle
# Funktioniert mit Hyper-V (Windows) UND VirtualBox (Windows/Linux/Mac).
# Provider waehlen mit: vagrant up --provider=virtualbox
#                    oder: vagrant up --provider=hyperv
#
# WICHTIG: v.vm.box und v.vm.network duerfen NICHT innerhalb eines
# "v.vm.provider do |p| ... end"-Blocks stehen. Dieser Block ist KEIN
# Conditional - er wird beim Parsen immer komplett ausgefuehrt, egal
# welcher Provider am Ende genutzt wird. Nur p.memory/p.cpus/p.vmname
# (Einstellungen auf dem provider-Objekt selbst) sind wirklich
# provider-spezifisch. Ein v.vm.network-Aufruf in JEDEM Provider-Block
# wuerde das Netzwerk mehrfach registrieren (-> doppelte/verwaiste
# Netzwerk-Adapter in VirtualBox). Deshalb hier: Provider einmalig
# ermitteln und Box/Netzwerk nur einmal setzen.

provider = (ARGV.find { |a| a.start_with?("--provider=") } || "").split("=")[1] ||
           ENV["VAGRANT_DEFAULT_PROVIDER"] || "virtualbox"

Vagrant.configure("2") do |config|

  config.vm.define "victim" do |v|
    v.vm.hostname = "victim"
    v.vm.synced_folder ".", "/vagrant", disabled: true
    v.vm.box = provider == "hyperv" ? "ubuntu-secnet-hyperv" : "ubuntu-secnet-virtualbox"
    v.vm.network "private_network",
      hyperv__switch_name: "lab01-net",
      virtualbox__intnet:  "lab01-net",
      ip: "172.30.0.10"

    v.vm.provider "hyperv" do |hv|
      hv.vmname = "lab01-victim"
      hv.memory = 512
      hv.cpus   = 1
    end

    v.vm.provider "virtualbox" do |vb|
      vb.name   = "lab01-victim"
      vb.memory = 512
      vb.cpus   = 1
    end

    v.vm.provision "shell", inline: <<-SHELL
      # Route zum Server zwingend ueber attacker leiten
      ip route del 172.30.0.20/32 2>/dev/null || true
      ip route add 172.30.0.20 via 172.30.0.99
      echo "[victim] 172.30.0.10 | Route zu server via attacker (172.30.0.99)"
    SHELL
  end

  config.vm.define "attacker" do |a|
    a.vm.hostname = "attacker"
    a.vm.synced_folder ".", "/vagrant", disabled: true
    a.vm.box = provider == "hyperv" ? "ubuntu-secnet-hyperv" : "ubuntu-secnet-virtualbox"
    a.vm.network "private_network",
      hyperv__switch_name: "lab01-net",
      virtualbox__intnet:  "lab01-net",
      ip: "172.30.0.99"

    a.vm.provider "hyperv" do |hv|
      hv.vmname = "lab01-attacker"
      hv.memory = 512
      hv.cpus   = 1
    end

    a.vm.provider "virtualbox" do |vb|
      vb.name   = "lab01-attacker"
      vb.memory = 512
      vb.cpus   = 1
    end

    a.vm.provision "shell", inline: <<-SHELL
      sysctl -w net.ipv4.ip_forward=1
      echo "net.ipv4.ip_forward=1" >> /etc/sysctl.conf
      echo "[attacker] 172.30.0.99 | IP-Forwarding aktiv, tcpdump bereit"
    SHELL
  end

  config.vm.define "server" do |s|
    s.vm.hostname = "server"
    s.vm.synced_folder ".", "/vagrant", disabled: true
    s.vm.box = provider == "hyperv" ? "ubuntu-secnet-hyperv" : "ubuntu-secnet-virtualbox"
    s.vm.network "private_network",
      hyperv__switch_name: "lab01-net",
      virtualbox__intnet:  "lab01-net",
      ip: "172.30.0.20"

    s.vm.provider "hyperv" do |hv|
      hv.vmname = "lab01-server"
      hv.memory = 512
      hv.cpus   = 1
    end

    s.vm.provider "virtualbox" do |vb|
      vb.name   = "lab01-server"
      vb.memory = 512
      vb.cpus   = 1
    end

    s.vm.provision "shell", inline: <<-SHELL
      # Rueckweg ebenfalls ueber attacker zwingen - ohne das wuerde die
      # Antwort per normalem ARP direkt an victim gehen (gleiches L2-Netz)
      # und am attacker komplett vorbeilaufen (asymmetrisches Routing).
      ip route del 172.30.0.10/32 2>/dev/null || true
      ip route add 172.30.0.10 via 172.30.0.99

      mkdir -p /var/www
      cat > /var/www/index.html << 'HTMLEOF'
Internes Mitarbeiterportal
==========================
Status:    Anmeldung erfolgreich
Benutzer:  muster
Passwort:  Sommer2026!
Abteilung: IT-Infrastruktur
HTMLEOF
      cd /var/www && nohup python3 -m http.server 8080 > /var/log/httpserver.log 2>&1 &
      echo "[server] HTTP-Server laeuft auf 172.30.0.20:8080 | Rueckweg via attacker (172.30.0.99)"
    SHELL
  end

end