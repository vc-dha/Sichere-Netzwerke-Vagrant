#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: secnet-base
    password: '$6$xVyW7mV1FzxkwL/t$l40YNyPORn3f.0yiYaEkblHVtfX/8UQjEo6Wyq57E5k3Ydj.h3vG4iWFBOZH3nLXhOUQyieIJxOnb3/Y0hx1U0' # Passwort: vagrant
    realname: vagrant
    username: vagrant
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct

  package_upgrade: true
  packages:
    - linux-tools-virtual
    - linux-cloud-tools-virtual
    - curl
    - sudo
    - openvswitch-switch
    - tcpdump
    - nmap
    - net-tools
    - iproute2
    - iptables
    - wireshark-common
    - tshark
    - netcat-openbsd
    - traceroute
    - iperf3
    # --- Lab-02 ARP-Spoofing + Lab-05 DNS-Spoofing ---
    - dsniff
    - ettercap-text-only
    # --- Lab-03 TLS-Analyse ---
    - ssldump
    - dnsutils
    # --- Lab-05 DNS-Poisoning ---
    - unbound
    - nsd
    - ldnsutils
    - nginx

  late-commands:
    - curtin in-target -- sh -c 'mkdir -p /home/vagrant/.ssh'
    - curtin in-target -- sh -c 'echo "ssh-rsa  vagrant insecure public key" > /home/vagrant/.ssh/authorized_keys'
    - curtin in-target -- sh -c 'chown -R vagrant:vagrant /home/vagrant/.ssh'
    - curtin in-target -- sh -c 'chmod 700 /home/vagrant/.ssh'
    - curtin in-target -- sh -c 'chmod 600 /home/vagrant/.ssh/authorized_keys'
    - curtin in-target -- sh -c 'test -s /home/vagrant/.ssh/authorized_keys'
    - curtin in-target -- sh -c 'printf "vagrant ALL=(ALL) NOPASSWD:ALL\n" > /etc/sudoers.d/vagrant'
    - curtin in-target -- sh -c 'chmod 440 /etc/sudoers.d/vagrant'
    - curtin in-target -- sh -c 'chown root:root /etc/sudoers.d/vagrant'
    - curtin in-target -- sh -c 'visudo -cf /etc/sudoers.d/vagrant'
    - curtin in-target -- sh -c 'echo "PasswordAuthentication yes" > /etc/ssh/sshd_config.d/01-packer.conf'
    - curtin in-target -- sh -c 'echo "PermitRootLogin yes" >> /etc/ssh/sshd_config.d/01-packer.conf'
    - curtin in-target -- sh -c 'systemctl enable hv-kvp-daemon'
    - curtin in-target -- sh -c 'systemctl enable openvswitch-switch'
    # unbound/nsd/nginx sollen NICHT automatisch starten - die Labs konfigurieren
    # und starten sie gezielt selbst (sonst blockieren sich Standard-Configs)
    - curtin in-target -- sh -c 'systemctl disable unbound nsd nginx 2>/dev/null || true'
